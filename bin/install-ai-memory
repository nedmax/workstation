#!/usr/bin/env bash
set -euo pipefail

repository="akitaonrails/ai-memory"
install_dir="$HOME/Applications/ai-memory"
bin_dir="$HOME/.local/bin"

case "$(uname -m)" in
  arm64) architecture="aarch64" ;;
  x86_64) architecture="x86_64" ;;
  *)
    printf 'Unsupported macOS architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

archive="ai-memory-macos-${architecture}.tar.gz"
release_url="https://github.com/${repository}/releases/latest/download"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

printf 'Downloading the latest ai-memory release for macOS %s...\n' "$architecture"
curl -fsSL "$release_url/$archive" -o "$tmp_dir/$archive"
curl -fsSL "$release_url/$archive.sha256" -o "$tmp_dir/$archive.sha256"

(
  cd "$tmp_dir"
  shasum -a 256 -c "$archive.sha256"
)

mkdir -p "$install_dir" "$bin_dir"
tar -xzf "$tmp_dir/$archive" -C "$install_dir"
ln -sfn "$install_dir/ai-memory" "$bin_dir/ai-memory"

printf 'Installed %s at %s\n' "$("$install_dir/ai-memory" --version)" "$install_dir"
